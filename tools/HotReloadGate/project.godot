config_version=5
custom_features="dotnet"

[application]
config/name="Damage Meter Reload Gate"
config/features=PackedStringArray("4.5", "C#", "GL Compatibility")
run/main_scene="res://Gate.tscn"
config/use_custom_user_dir=true
config/custom_user_dir_name="DamageMeterReloadGate"

[dotnet]
project/assembly_name="HotReloadGate"

[rendering]
renderer/rendering_method="gl_compatibility"
